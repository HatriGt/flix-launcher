<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <SurfaceView
        android:id="@+id/wallpaper_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <!-- SurfaceView ignores view alpha, so the video fades in from under this veil instead. -->
    <View
        android:id="@+id/video_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fallback_background" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black" />

    <FrameLayout
        android:id="@+id/ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/hero_backdrop_a"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/hero_backdrop_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <!-- The trailer's WebView is created here only while a trailer plays. -->
            <FrameLayout
                android:id="@+id/hero_trailer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/hero_shade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_shade" />

            <LinearLayout
                android:id="@+id/hero_info"
                android:layout_width="470dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/hero_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="96dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxWidth="470dp"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hero_title"
                    style="@style/Flix.Text"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:letterSpacing="-0.01"
                    android:textStyle="bold"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/hero_meta"
                    style="@style/Flix.Text"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/hero_description"
                    style="@style/Flix.Text.Muted"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="2"
                    android:textSize="14sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Compact top bar: greeting, time and a weather chip, like a web page header. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="20dp"
            android:paddingEnd="48dp">

            <!-- Clock on the left; greeting and date stacked beside it, split by a hairline. -->
            <LinearLayout
                android:id="@+id/clock_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.flix.launcher.ClockView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="16dp"
                    android:background="#40FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Flix.Text"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/date"
                            style="@style/Flix.Text.Muted"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:textColor="#A6FFFFFF"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>

                <com.flix.launcher.SunArcView
                    android:id="@+id/sun_arc"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Netflix-style top menu: a row of pill tabs in a translucent capsule. -->
            <LinearLayout
                android:id="@+id/nav_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/nav_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/nav_search"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/nav_pill"
                    android:contentDescription="Search"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/nav_text" />

                <TextView
                    android:id="@+id/nav_home"
                    style="@style/Flix.NavTab"
                    android:text="Home" />
                <TextView
                    android:id="@+id/nav_movies"
                    style="@style/Flix.NavTab"
                    android:text="Movies" />
                <TextView
                    android:id="@+id/nav_shows"
                    style="@style/Flix.NavTab"
                    android:text="Shows" />
                <TextView
                    android:id="@+id/nav_apps"
                    style="@style/Flix.NavTab"
                    android:text="Apps" />

                <!-- The Nuvio profile in use: OK switches to another (shown when signed in). -->
                <TextView
                    android:id="@+id/nav_profile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Switch profile"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:background="@drawable/weather_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/weather_icon"
                    style="@style/Flix.Text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/weather_temp"
                    style="@style/Flix.Text"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_condition"
                        style="@style/Flix.Text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/weather_place"
                        style="@style/Flix.Text.Muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_details"
                    style="@style/Flix.Text.Muted"
                    android:visibility="gone" />

                <View
                    android:id="@+id/forecast_divider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/forecast"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <com.flix.launcher.RowsScrollView
            android:id="@+id/rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/favorites_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="76dp">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="44dp"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/focused_label"
                        style="@style/Flix.Text"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="20sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/hint"
                        style="@style/Flix.Text.Muted"
                        android:layout_marginBottom="3dp"
                        android:alpha="0.7"
                        android:text="Hold OK for options"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/glass_dock"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="14dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favorites"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="124dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="8dp" />
                    <LinearLayout
                        android:id="@+id/quick_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/qs_inputs"
                            style="@style/Flix.QuickButton"
                            android:contentDescription="Inputs"
                            android:src="@drawable/ic_input" />

                        <ImageButton
                            android:id="@+id/qs_wifi"
                            style="@style/Flix.QuickButton"
                            android:contentDescription="Network"
                            android:src="@drawable/ic_wifi" />

                        <ImageButton
                            android:id="@+id/qs_flix"
                            style="@style/Flix.QuickButton"
                            android:contentDescription="Flix Launcher settings"
                            android:src="@drawable/ic_tune" />

                        <ImageButton
                            android:id="@+id/qs_settings"
                            style="@style/Flix.QuickButton"
                            android:contentDescription="Settings"
                            android:src="@drawable/ic_settings" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/all_apps_label"
                    style="@style/Flix.Text.Muted"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.12"
                    android:text="ALL APPS"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/apps"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="40dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="40dp" />
                </LinearLayout>

                <Space
                    android:id="@+id/rows_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />


                <LinearLayout
                    android:id="@+id/movie_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <Space
                    android:id="@+id/rows_tail"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />
            </LinearLayout>
        </com.flix.launcher.RowsScrollView>
    </FrameLayout>
        <!-- Name of the wallpaper photo, shown in the corner only while the page is idle and the photo is on show. -->
    <TextView
        android:id="@+id/scene_title"
        style="@style/Flix.Text.Muted"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        android:ellipsize="end"
        android:maxWidth="420dp"
        android:singleLine="true"
        android:textSize="11sp" />
</FrameLayout>
