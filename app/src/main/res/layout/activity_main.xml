<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fallback_background">

    <ImageView
        android:id="@+id/wallpaper_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/wallpaper_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:focusable="false"
        app:resize_mode="zoom"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- SurfaceView ignores view alpha, so the video fades in from under this veil instead. -->
    <View
        android:id="@+id/video_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fallback_background" />

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black" />

    <FrameLayout
        android:id="@+id/ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/hero_backdrop_a"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/hero_backdrop_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <WebView
                android:id="@+id/hero_trailer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:focusable="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_shade" />

            <LinearLayout
                android:id="@+id/hero_info"
                android:layout_width="470dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginTop="26dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/hero_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxWidth="320dp"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hero_title"
                    style="@style/Aura.Text"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/hero_meta"
                    style="@style/Aura.Text"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hero_description"
                    style="@style/Aura.Text.Muted"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="2"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Aura.Text.Muted"
                    android:layout_marginTop="10dp"
                    android:alpha="0.7"
                    android:text="OK to open in Nuvio  ·  Hold OK for more"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Compact top bar: greeting, time and a weather chip, like a web page header. -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingTop="20dp"
            android:paddingEnd="48dp">

            <LinearLayout
                android:id="@+id/clock_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    style="@style/Aura.Text"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.tvlauncher.aura.ClockView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/date"
                        style="@style/Aura.Text.Muted"
                        android:layout_marginStart="12dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/scene_title"
                        style="@style/Aura.Text.Muted"
                        android:layout_marginStart="14dp"
                        android:alpha="0.7"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.tvlauncher.aura.SunArcView
                    android:id="@+id/sun_arc"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:background="@drawable/weather_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/weather_icon"
                    style="@style/Aura.Text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/weather_temp"
                    style="@style/Aura.Text"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weather_condition"
                        style="@style/Aura.Text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/weather_place"
                        style="@style/Aura.Text.Muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weather_details"
                    style="@style/Aura.Text.Muted"
                    android:visibility="gone" />

                <View
                    android:id="@+id/forecast_divider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/forecast"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <com.tvlauncher.aura.RowsScrollView
            android:id="@+id/rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdge="none"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/favorites_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="76dp">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="44dp"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/focused_label"
                        style="@style/Aura.Text"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="20sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/hint"
                        style="@style/Aura.Text.Muted"
                        android:layout_marginBottom="3dp"
                        android:alpha="0.7"
                        android:text="Hold OK for options"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/glass_dock"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="14dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favorites"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="124dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="8dp" />
                    <LinearLayout
                        android:id="@+id/quick_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/qs_inputs"
                            style="@style/Aura.QuickButton"
                            android:contentDescription="Inputs"
                            android:src="@drawable/ic_input" />

                        <ImageButton
                            android:id="@+id/qs_wifi"
                            style="@style/Aura.QuickButton"
                            android:contentDescription="Network"
                            android:src="@drawable/ic_wifi" />

                        <ImageButton
                            android:id="@+id/qs_aura"
                            style="@style/Aura.QuickButton"
                            android:contentDescription="Aura settings"
                            android:src="@drawable/ic_tune" />

                        <ImageButton
                            android:id="@+id/qs_settings"
                            style="@style/Aura.QuickButton"
                            android:contentDescription="Settings"
                            android:src="@drawable/ic_settings" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/all_apps_label"
                    style="@style/Aura.Text.Muted"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.12"
                    android:text="ALL APPS"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/apps"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="40dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="40dp" />
                </LinearLayout>

                <Space
                    android:id="@+id/rows_spacer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />


                <LinearLayout
                    android:id="@+id/movie_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <Space
                    android:id="@+id/rows_tail"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />
            </LinearLayout>
        </com.tvlauncher.aura.RowsScrollView>
    </FrameLayout>
</FrameLayout>
